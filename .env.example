# Adresse de l'API AfriVibe. Pour un appareil physique (Expo Go) ou un
# émulateur, "localhost" ne fonctionne PAS — utilisez l'adresse IP locale de
# la machine qui héberge le backend (ex: ipconfig sous Windows, repérer
# l'adaptateur Wi-Fi/Ethernet avec une passerelle par défaut).
#
# Le téléphone et l'ordinateur doivent être sur le MÊME réseau Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.1.29:3000/api/v1
